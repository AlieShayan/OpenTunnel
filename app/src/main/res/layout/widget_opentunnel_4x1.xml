<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 Horizontal Bar Home-screen widget layout for OpenTunnel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- Orb / status icon — tap opens the app -->
    <ImageView
        android:id="@+id/widget_orb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_widget_orb_idle"
        android:contentDescription="@string/widget_orb_desc" />

    <!-- Center Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center_vertical">

        <!-- Line 1: Profile / Server name & State -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_server"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenTunnel"
                android:textColor="#E4E9F4"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/widget_status_disconnected"
                android:textColor="#A9B4C9"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0:00:00"
                android:textColor="#5EE7C4"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Line 2: IP & Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#A9B4C9"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text=""
                android:textColor="#A9B4C9"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Line 3: Traffic & Ping -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_traffic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#5EE7C4"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text=""
                android:textColor="#FFD54F"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right: Connect / Disconnect button -->
    <Button
        android:id="@+id/widget_btn_toggle"
        android:layout_width="86dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_btn_idle_bg"
        android:text="@string/widget_btn_connect"
        android:textColor="#A9B4C9"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="true"
        android:letterSpacing="0.04" />

</LinearLayout>
