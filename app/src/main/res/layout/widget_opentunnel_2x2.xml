<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 Compact Home-screen widget layout for OpenTunnel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:gravity="center">

    <!-- Orb / status icon — tap opens the app -->
    <ImageView
        android:id="@+id/widget_orb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_widget_orb_idle"
        android:contentDescription="@string/widget_orb_desc" />

    <!-- State label -->
    <TextView
        android:id="@+id/widget_status_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_status_disconnected"
        android:textColor="#A9B4C9"
        android:textSize="9sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:textAllCaps="true" />

    <!-- Profile & Server name -->
    <TextView
        android:id="@+id/widget_server"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text=""
        android:textColor="#E4E9F4"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Outbound IP -->
    <TextView
        android:id="@+id/widget_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text=""
        android:textColor="#A9B4C9"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Location info -->
    <TextView
        android:id="@+id/widget_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text=""
        android:textColor="#A9B4C9"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Traffic stats -->
    <TextView
        android:id="@+id/widget_traffic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text=""
        android:textColor="#5EE7C4"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:visibility="gone" />

    <!-- Ping -->
    <TextView
        android:id="@+id/widget_ping"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text=""
        android:textColor="#FFD54F"
        android:textSize="9sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:visibility="gone" />

    <!-- Elapsed time -->
    <TextView
        android:id="@+id/widget_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0:00:00"
        android:textColor="#E4E9F4"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- Connect / Disconnect button -->
    <Button
        android:id="@+id/widget_btn_toggle"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_btn_idle_bg"
        android:text="@string/widget_btn_connect"
        android:textColor="#A9B4C9"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="true"
        android:letterSpacing="0.04" />

</LinearLayout>
