<?xml version="1.0" encoding="utf-8"?>
<!--
  The profile is encrypted with a hardware-backed Keystore key that never leaves
  the device, so backing it up would only restore unusable ciphertext.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
