<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 6.0 (API 23) to Android 11 (API 30).
  Prevents private keys, passwords, and stored data from being extracted via ADB backup.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
</full-backup-content>
